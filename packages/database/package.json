{
  "name": "@property-assistant/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:status": "tsx src/cli/status.ts",
    "db:verify": "tsx src/cli/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "kysely": "^0.28.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
