{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@property-assistant/config": ["./src/stubs/config.ts"],
      "@property-assistant/config/*": ["./src/stubs/config.ts"],
      "@property-assistant/types": ["./src/stubs/types.ts"],
      "@property-assistant/types/*": ["./src/stubs/types.ts"]
    }
  },
  "include": [
    "src/livekit-worker.ts",
    "src/stubs/config.ts",
    "src/stubs/types.ts"
  ]
}
