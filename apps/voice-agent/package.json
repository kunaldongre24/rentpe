{
  "name": "@property-assistant/voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env --import tsx/esm src/livekit-worker.ts dev",
    "start": "node --env-file=../../.env dist/livekit-worker.js start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.7.0",
    "@livekit/agents-plugin-elevenlabs": "^1.7.0",
    "@livekit/agents-plugin-sarvam": "^1.7.0",
    "@livekit/rtc-node": "^0.13.34",
    "@property-assistant/config": "workspace:*",
    "@property-assistant/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
