NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
VOICE_AGENT_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://api:3001
INTERNAL_API_TOKEN=replace-with-a-long-random-development-token

# Provider placeholders. External Vobiz, LiveKit, and Meta WhatsApp connections are account/configuration dependent.
POSTGRES_DB=property_assistant
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=property_assistant_dev
DATABASE_URL=postgresql://supabase_admin:property_assistant_dev@localhost:5432/property_assistant
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
ALLOW_DATABASE_RESET=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=
VOBIZ_ACCOUNT_ID=
VOBIZ_DID=
VOBIZ_SIP_HOST=
VOBIZ_SIP_PORT=5060
VOBIZ_SIP_TRANSPORT=tls
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=
# WhatsApp provider: local (default) or gupshup
WHATSAPP_PROVIDER=local
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_API_BASE_URL=https://api.gupshup.io
